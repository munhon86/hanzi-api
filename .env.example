# Copy to .env and fill in. .env is gitignored and must never be committed.
# Anthropic API key for the Claude-backed writing correction + tap-to-explain endpoints.
ANTHROPIC_API_KEY=

# OpenAI API key for pronunciation audio transcription.
OPENAI_API_KEY=

# Optional: override the default model (claude-sonnet-4-5).
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: override the default speech-to-text model (gpt-4o-transcribe).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
